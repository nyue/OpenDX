# A single tetrahedron's four faces, with one scalar per vertex.
object 1 class array type float rank 1 shape 3 items 4 data follows
  0 0 0
  1 0 0
  0 1 0
  0 0 1
object 2 class array type int rank 1 shape 3 items 4 data follows
  0 1 2
  0 1 3
  0 2 3
  1 2 3
attribute "element type" string "triangles"
attribute "ref" string "positions"
object 3 class array type float rank 0 items 4 data follows
  0.0 1.0 2.0 3.0
attribute "dep" string "positions"
object "tetra" class field
component "positions" value 1
component "connections" value 2
component "data" value 3
end
