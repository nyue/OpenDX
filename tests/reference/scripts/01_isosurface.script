// Isosurface of r^2 on a regular grid: a shaded sphere.
g = Construct([-1 -1 -1], [0.1 0.1 0.1], [21 21 21]);
m = Mark(g, "positions");
f = Compute("$0.x*$0.x + $0.y*$0.y + $0.z*$0.z", m);
iso = Isosurface(f, 0.5);
obj = Color(iso, "orange");
cam = AutoCamera(obj, "front", NULL, 320);
img = Render(obj, cam);
WriteImage(img, "out", "rgb");
