// A coloured slice with its colour bar.
g = Construct([-1 -1 -1], [0.1 0.1 0.1], [21 21 21]);
m = Mark(g, "positions");
f = Compute("sin(3*$0.x) * cos(3*$0.y) + $0.z", m);
plane = MapToPlane(f, [0 0 0], [0 0 1]);
slice, cmap = AutoColor(plane);
bar = ColorBar(cmap, [0.95 0.95], [150 15], 1, NULL, NULL, NULL, "value");
obj = Collect(slice, bar);
cam = AutoCamera(slice, "front", NULL, 320);
img = Render(obj, cam);
WriteImage(img, "out", "rgb");
